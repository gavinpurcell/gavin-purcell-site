{
  "redirects": [
    {
      "source": "/cart",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/ai-for-humans",
      "destination": "/#aifh",
      "statusCode": 301
    },
    {
      "source": "/home",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/ai.txt",
      "destination": "/llms.txt",
      "statusCode": 301
    },
    {
      "source": "/llms-full-text.txt",
      "destination": "/llms-full.txt",
      "statusCode": 301
    },
    {
      "source": "/agents",
      "destination": "/llms.txt",
      "statusCode": 301
    },
    {
      "source": "/agents.md",
      "destination": "/llms.txt",
      "statusCode": 301
    },
    {
      "source": "/.well-known/llms.txt",
      "destination": "/llms.txt",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/((?!_vercel/).*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\""
        }
      ]
    },
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept, Accept-Encoding"
        }
      ]
    }
  ]
}
